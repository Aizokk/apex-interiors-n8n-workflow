        "messages": {
          "values": [
            {
              "content": "=You are an operations assistant for Apex Interiors Kenya, a Nairobi-based interior design and renovation company.\n\nAnalyze the customer enquiry below and return ONLY valid JSON with no markdown, no code fences, and no extra commentary.\n\nRequired JSON schema:\n{\n  \"fullName\": \"string\",\n  \"email\": \"string\",\n  \"phone\": \"string\",\n  \"projectType\": \"string\",\n  \"budget\": number,\n  \"summary\": \"string (2-3 concise sentences summarizing the scope, style/requirements, and urgency)\"\n}\n\nRules:\n- Convert budget to a clean numeric KES value with no commas or currency symbols (e.g., 75000). If unclear or missing, use 0.\n- Keep phone as an empty string \"\" if not provided.\n- Keep summary professional, factual, and useful for an interior design consultant.\n\nCustomer Enquiry:\n- Full Name: {{ $json.fullName }}\n- Email: {{ $json.email }}\n- Phone: {{ $json.phone }}\n- Project Type: {{ $json.projectType }}\n- Estimated Budget: {{ $json.budgetInput }}\n- Project Description: {{ $json.description }}\n- Submitted At: {{ $json.submittedAt }}\n",
              "role": "=user"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        448,
        0
      ],
      "id": "6813e431-f78e-44fb-a9bc-9c3d1183b24c",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "VI8BN6V6XUuFarGi",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.content.parts[0].text;\n\nif (!raw || typeof raw !== 'string') {\n  throw new Error('Gemini output text is missing.');\n}\n\nconst cleaned = raw\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (err) {\n  throw new Error('Failed to parse Gemini JSON: ' + err.message + ' | Raw: ' + cleaned);\n}\n\nconst budget = Number(parsed.budget);\nif (Number.isNaN(budget) || budget < 0) {\n  throw new Error('Invalid budget returned by Gemini: ' + parsed.budget);\n}\n\nconst leadData = $('Edit Fields').first().json;\n\nreturn {\n  json: {\n    fullName: String(parsed.fullName || leadData.fullName || '').trim(),\n    email: String(parsed.email || leadData.email || '').trim(),\n    phone: String(parsed.phone || leadData.phone || '').trim(),\n    projectType: String(parsed.projectType || leadData.projectType || '').trim(),\n    budget,\n    summary: String(parsed.summary || '').trim(),\n    description: String(leadData.description || '').trim(),\n    submittedAt: String(leadData.submittedAt || new Date().toISOString()).trim()\n  }\n};\n"
      },
